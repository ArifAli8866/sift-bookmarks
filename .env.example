# ==============================================================================
# Sift Environment Configuration
# ==============================================================================

# 1. Database Configuration (Required for Production / Vercel Deployments)
# Neon PostgreSQL connection string (https://console.neon.tech)
# NOTE: If omitted locally, Sift automatically uses embedded PostgreSQL on disk (.data/sift_pg).
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# 2. Session Secret (Optional - defaults to auto-generated secure key if not specified)
# SIFT_SESSION_SECRET="your-random-32-character-secret-key-here"

# 3. Google OAuth Authentication (Optional - for "Continue with Google")
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorized Javascript Origins:
#   - Local: http://localhost:3000
#   - Production: https://sift-bookmarks.vercel.app
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
