{
  "name": "Sift — Bookmarks for Developers",
  "short_name": "Sift",
  "description": "A keyboard-first bookmark manager for links, docs, and developer tools.",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#090A10",
  "theme_color": "#131424",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
